{%- comment -%} v59: live game lists in the schema come from snippets/rs-live-games (new games only once their hub page exists). {%- endcomment -%}
{%- capture rs_lg_long -%}{%- render 'rs-live-games', names: 'long' -%}{%- endcapture -%}
{%- capture rs_lg_mixed -%}{%- render 'rs-live-games', names: 'mixed' -%}{%- endcapture -%}
{%- liquid
  # v71: Fortnite tool pages use their SVG hero on the page; for schema and share previews they borrow the matching Fortnite guide image.
  assign rs_fn_img = blank
  if template.name == 'page'
    case page.handle
      when 'fortnite-stats'
        assign rs_fn_img = articles['news/fortnite-stats-explained'].image
      when 'fortnite-item-shop'
        assign rs_fn_img = articles['news/fortnite-item-shop-explained'].image
      when 'fortnite-leaderboard'
        assign rs_fn_img = articles['news/fortnite-ranked-explained'].image
      when 'fortnite-map'
        assign rs_fn_img = articles['news/how-to-use-ranksurge-fortnite-tools'].image
    endcase
  endif
-%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://ranksurge.games/#org",
      "name": "RankSurge",
      "url": "https://ranksurge.games/",
      "email": "sales@ranksurge.games",{% if settings.logo != blank %}
      "logo": {{ settings.logo | image_url: width: 600 | prepend: 'https:' | json }},{% endif %}
      "description": {{ 'Free player stats tracker and guides for competitive games, with live lookups for ' | append: rs_lg_long | append: ', and rank guides for League of Legends, Teamfight Tactics, Valorant, Overwatch 2 and Marvel Rivals.' | json }},
      "knowsAbout": ["Fortnite", "Counter-Strike 2", "Deadlock", "Dota 2", "Destiny 2", "PUBG: Battlegrounds", "World of Warcraft", "StarCraft II", "Brawl Stars", "Clash Royale", "Clash of Clans", "Chess", "Path of Exile 2", "Rust", "Team Fortress 2", "League of Legends", "Teamfight Tactics", "Valorant", "Overwatch 2", "Marvel Rivals", "Competitive ranked systems", "Esports player statistics"]
    },
    {
      "@type": "Organization",
      "@id": "https://aiwebsitedesignswfl.com/#org",
      "name": "AI Website Design SWFL",
      "url": "https://aiwebsitedesignswfl.com/"
    },
    {
      "@type": "WebSite",
      "@id": "https://ranksurge.games/#site",
      "name": "RankSurge",
      "url": "https://ranksurge.games/",
      "inLanguage": "en-US",
      "publisher": {"@id": "https://ranksurge.games/#org"},
      "creator": {"@id": "https://aiwebsitedesignswfl.com/#org"},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {"@type": "EntryPoint", "urlTemplate": "https://ranksurge.games/pages/player-lookup?q={search_term_string}"},
        "query-input": "required name=search_term_string"
      }
    }{% if template.name == 'page' %},
    {
      "@type": "WebPage",
      "@id": {{ canonical_url | append: '#page' | json }},
      "url": {{ canonical_url | json }},
      "name": {{ page.title | json }},
      "description": {{ page_description | default: '' | json }},
      "inLanguage": "en-US",
      "isPartOf": {"@id": "https://ranksurge.games/#site"}{%- liquid
        assign rs_hero = page.metafields.custom.hero_image.value
        if rs_hero == blank
          assign rs_hero_name = 'ranksurge-' | append: page.handle | append: '-hero.png'
          assign rs_hero = images[rs_hero_name]
        endif
        if rs_hero == blank and rs_fn_img != blank
          assign rs_hero = rs_fn_img
        endif
      -%}{% if rs_hero != blank %},
      "primaryImageOfPage": {"@type": "ImageObject", "url": {{ rs_hero | image_url: width: 1200 | prepend: 'https:' | json }}}{% endif %}{% if page.published_at %},
      "datePublished": {{ page.published_at | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}{% endif %}{% if page.metafields.custom.last_reviewed.value != blank %},
      "dateModified": {{ page.metafields.custom.last_reviewed.value | date: '%Y-%m-%dT%H:%M:%S%:z' | json }}{% endif %}{% if page.metafields.custom.about_game.value != blank %},
      "about": {"@type": "VideoGame", "name": {{ page.metafields.custom.about_game.value | json }}}{% endif %},
      "breadcrumb": {
        "@type": "BreadcrumbList",
        "itemListElement": [
          {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://ranksurge.games/"},
          {"@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ canonical_url | json }}}
        ]
      }
    }{%- comment -%} v69: Fortnite tool pages, CS2 tools, WoW leaderboards and the Player Hub are WebApplications too. {%- endcomment -%}{%- assign rs_apps = 'deadlock-stats,cs2-stats,dota-2-stats,destiny-2-stats,pubg-stats,league-of-legends-stats,tft-stats,wow-stats,dota-2-hero-tier-list,player-lookup,compare-players,destiny-2-vault-manager,destiny-2-weapons,destiny-2-armor,destiny-2-build-planner,destiny-2-best-weapons-and-armor,marathon-stats,marathon-runner-shells,marathon-weapons,marathon-loadout-planner,rank-goal-planner,starcraft-2-stats,brawl-stars-stats,clash-royale-stats,clash-of-clans-stats,world-of-tanks-stats,chess-stats,lichess-stats,osu-stats,hypixel-stats,world-of-warships-stats,world-of-tanks-blitz-stats,path-of-exile-2-stats,rust-stats,tf2-stats,fortnite-stats,fortnite-item-shop,fortnite-leaderboard,fortnite-map,cs2-inventory-value,cs2-pro-comparisons,wow-leaderboards,player-hub,stats-badge' | split: ',' -%}{% if rs_apps contains page.handle %},
    {
      "@type": "WebApplication",
      "@id": {{ canonical_url | append: '#app' | json }},
      "name": {{ page.title | prepend: 'RankSurge ' | json }},
      "url": {{ canonical_url | json }},
      "applicationCategory": {% if page.handle == 'rank-goal-planner' %}"UtilitiesApplication"{% else %}"GameApplication"{% endif %},
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "isAccessibleForFree": true,
      "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},{% if page.metafields.custom.about_game.value != blank %}
      "about": {"@type": "VideoGame", "name": {{ page.metafields.custom.about_game.value | json }}},{% endif %}
      "publisher": {"@id": "https://ranksurge.games/#org"},
      "isPartOf": {"@id": "https://ranksurge.games/#site"}
    }{% endif %}{% endif %}{% if template.name == 'index' %},
    {
      "@type": "WebPage",
      "@id": "https://ranksurge.games/#home",
      "url": "https://ranksurge.games/",
      "name": "Free Game Stats Tracker for Competitive Games",
      "inLanguage": "en-US",
      "isPartOf": {"@id": "https://ranksurge.games/#site"},
      "about": {"@id": "https://ranksurge.games/#app"}
    },
    {
      "@type": "WebApplication",
      "@id": "https://ranksurge.games/#app",
      "name": "RankSurge Game Stats Tracker",
      "url": "https://ranksurge.games/",
      "applicationCategory": "GameApplication",
      "operatingSystem": "Any",
      "browserRequirements": "Requires JavaScript",
      "isAccessibleForFree": true,
      "offers": {"@type": "Offer", "price": "0", "priceCurrency": "USD"},
      "featureList": [{{ 'Player stats lookup for ' | append: rs_lg_mixed | json }}, "Rank history and match reports", "AI Profile Pick player comparison", "Destiny 2 vault manager and clan board", "CS2 pro comparisons and inventory value checker", "World of Warcraft Mythic+ and PvP leaderboards and guild board", "Live Dota 2 hero tier list", "Fortnite Item Shop tracker with reset countdown and wishlist", "Opt-in Fortnite leaderboard and head-to-head player compare", "Fortnite map with named locations and a random drop picker", "75 free ranked-climbing guides with sources"],
      "publisher": {"@id": "https://ranksurge.games/#org"}
    }{% endif %}{% if template.name == 'blog' %},
    {
      "@type": "Blog",
      "@id": {{ blog.url | prepend: 'https://ranksurge.games' | json }},
      "url": {{ blog.url | prepend: 'https://ranksurge.games' | json }},
      "name": {{ blog.title | json }},
      "publisher": {"@id": "https://ranksurge.games/#org"},
      "isPartOf": {"@id": "https://ranksurge.games/#site"},
      "breadcrumb": {"@type": "BreadcrumbList", "itemListElement": [
        {"@type": "ListItem", "position": 1, "name": "Home", "item": "https://ranksurge.games/"},
        {"@type": "ListItem", "position": 2, "name": {{ blog.title | json }}, "item": {{ blog.url | prepend: 'https://ranksurge.games' | json }}}
      ]}
    }{% endif %}
  ]
}
</script>
{%- comment -%} v54: ItemList on the guide hubs, built from the rs-post__h card links already in the page body. {%- endcomment -%}
{%- if template.name == 'page' -%}
{%- assign rs_hubs = 'guide-library,guides,ranks-explained,stats-explained,roles-explained' | split: ',' -%}
{%- if rs_hubs contains page.handle and page.content contains 'class="rs-post__h"><a href="' -%}
{%- assign rs_cards = page.content | split: 'class="rs-post__h"><a href="' -%}
<script type="application/ld+json">{"@context":"https://schema.org","@type":"ItemList","name":{{ page.title | json }},"url":{{ canonical_url | json }},"numberOfItems":{{ rs_cards.size | minus: 1 }},"itemListElement":[
{%- for c in rs_cards offset: 1 -%}{%- assign u = c | split: '"' | first -%}{%- assign t = c | split: '</a>' | first | split: '">' | last -%}{%- unless u contains '://' -%}{%- assign u = u | prepend: 'https://ranksurge.games' -%}{%- endunless -%}
{"@type":"ListItem","position":{{ forloop.index }},"url":{{ u | json }},"name":{{ t | strip_html | strip | json }}}{% unless forloop.last %},{% endunless %}
{%- endfor -%}]}</script>
{%- endif -%}
{%- endif -%}
{%- if template.name == 'page' and page.metafields.custom.faq_schema.value != blank -%}
<script type="application/ld+json">{{ page.metafields.custom.faq_schema.value | json }}</script>
{%- endif -%}
{%- comment -%} v83: on a loaded player profile, offer a stats badge that links back to that profile (earns backlinks). {%- endcomment -%}
{%- assign rs_bg = 'cs2-stats:cs2,deadlock-stats:deadlock,destiny-2-stats:destiny-2,dota-2-stats:dota-2,fortnite-stats:fortnite,pubg-stats:pubg,wow-stats:wow,starcraft-2-stats:starcraft-2,brawl-stars-stats:brawl-stars,clash-royale-stats:clash-royale,clash-of-clans-stats:clash-of-clans,chess-stats:chess,lichess-stats:lichess,rust-stats:rust,tf2-stats:tf2' | split: ',' -%}
{%- if template.name == 'page' -%}{%- for rs_b in rs_bg -%}{%- assign rs_bp = rs_b | split: ':' -%}{%- if rs_bp[0] == page.handle -%}
<script>(function(){var g={{ rs_bp[1] | json }};function show(){var q=new URLSearchParams(location.search),k=0;q.forEach(function(v,n){if(v&&!/^utm_|^fbclid$|^gclid$/.test(n))k++});var el=document.getElementById('rs-badge-chip');if(!k){if(el)el.remove();return}if(el){el.href=h();return}
function h(){return '/pages/stats-badge?g='+g+'&u='+encodeURIComponent(location.pathname+location.search)}
el=document.createElement('a');el.id='rs-badge-chip';el.href=h();el.textContent='Get your stats badge';el.setAttribute('aria-label','Make a free stats badge for this profile');
el.style.cssText='position:fixed;left:16px;bottom:16px;z-index:40;display:inline-flex;align-items:center;gap:8px;min-height:44px;padding:10px 16px;border-radius:999px;background:linear-gradient(90deg,#22D3EE,#8B5CF6);color:#0B0E17;font-family:inherit;font-size:15px;font-weight:700;line-height:1.2;text-decoration:none;box-shadow:0 8px 24px rgba(0,0,0,.4)';
el.insertAdjacentHTML('afterbegin','<svg width="18" height="18" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><rect x="2" y="18" width="7" height="12" rx="1.5" fill="currentColor"/><rect x="12" y="11" width="7" height="19" rx="1.5" fill="currentColor"/><rect x="22" y="4" width="7" height="26" rx="1.5" fill="currentColor"/></svg>');document.body.appendChild(el)}
document.addEventListener('DOMContentLoaded',show);window.addEventListener('popstate',show);['pushState','replaceState'].forEach(function(m){var o=history[m];history[m]=function(){var r=o.apply(this,arguments);setTimeout(show,0);return r}});})();</script>
{%- endif -%}{%- endfor -%}{%- endif -%}
