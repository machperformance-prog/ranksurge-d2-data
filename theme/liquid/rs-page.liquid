{% schema %}
{"name":"RankSurge page","blocks":[{"type":"lookup","name":"Player lookup tool","limit":1},{"type":"contact","name":"Contact form","limit":1},{"type":"dashboard","name":"Advertiser dashboard","limit":1}],"settings":[{"type":"header","content":"RankSurge Pro"},{"type":"text","id":"pro_pass_key","label":"Pro pass key","info":"Paste the same value you saved as the Worker secret RS_PASS_SECRET. It never appears on the storefront. Leave blank to turn Pro unlimited AI picks off."},{"type":"header","content":"Bot protection"},{"type":"text","id":"turnstile_site_key","label":"Cloudflare Turnstile site key","info":"The public site key from Cloudflare Turnstile. Put the matching secret key in the Worker as TURNSTILE_SECRET. Leave blank to turn the human check off."}]}
{% endschema %}
