{%- comment -%} Hero image order (v53): 1) page metafield custom.hero_image (file_reference, set per page in admin);
  2) a Sidekick file named ranksurge-<page handle>-hero.png in Content > Files (images global lookup);
  3) none: the CSS gradient hero. Sidekick sometimes renames files on save (e.g. adds a suffix), so if a file
  does not show, check its exact name in Files or set the metafield instead. {%- endcomment -%}
{%- liquid
  assign hero = page.metafields.custom.hero_image.value
  if hero == blank
    assign hero_name = 'ranksurge-' | append: page.handle | append: '-hero.png'
    assign hero = images[hero_name]
  endif
  # v69: built-in neon SVG heroes for the Fortnite pages (theme assets), used only when no metafield or Files image exists.
  assign hero_svg = ''
  if hero == blank and 'fortnite-stats,fortnite-item-shop,fortnite-leaderboard,fortnite-map,path-of-exile-2-stats,rust-stats,tf2-stats,marathon-stats,marathon-runner-shells,marathon-weapons,marathon-loadout-planner' contains page.handle
    assign hero_svg = 'rs-hero-' | append: page.handle | append: '.svg'
  endif
-%}
{%- assign sub = page.metafields.custom.subtitle.value -%}
{%- assign hero_alt = page.metafields.custom.hero_alt.value | default: hero.alt | default: page.title -%}
{%- liquid
  assign hubs = 'valorant-stats:valorant,league-of-legends-stats:league-of-legends,cs2-stats:counter-strike-2,deadlock-stats:deadlock,destiny-2-stats:destiny-2,destiny-2-weapons:destiny-2,destiny-2-armor:destiny-2,destiny-2-build-planner:destiny-2,destiny-2-best-weapons-and-armor:destiny-2,marvel-rivals-stats:marvel-rivals,overwatch-2-stats:overwatch-2,dota-2-stats:dota-2,fortnite-stats:fortnite,fortnite-item-shop:fortnite,fortnite-leaderboard:fortnite,fortnite-map:fortnite,pubg-stats:pubg,tft-stats:tft,wow-stats:wow,starcraft-2-stats:sc2,brawl-stars-stats:bs,clash-royale-stats:cr,clash-of-clans-stats:coc,world-of-tanks-stats:wot,chess-stats:chess,lichess-stats:lichess,osu-stats:osu,hypixel-stats:hypixel,world-of-warships-stats:wows,world-of-tanks-blitz-stats:wotb,path-of-exile-2-stats:poe2,rust-stats:rust,tf2-stats:tf2' | split: ','
  assign hubg = ''
  for h in hubs
    assign pr = h | split: ':'
    if pr[0] == page.handle
      assign hubg = pr[1]
    endif
  endfor
  assign body = page.content
  if body contains 'rs-post__meta'
    assign glist = 'Valorant:valorant,League of Legends:league-of-legends,Counter-Strike 2:counter-strike-2,Deadlock:deadlock,Destiny 2:destiny-2,Marvel Rivals:marvel-rivals,Overwatch 2:overwatch-2,Overwatch:overwatch-2,Dota 2:dota-2,Fortnite:fortnite,PUBG:pubg,Teamfight Tactics:tft,TFT:tft,World of Warcraft:wow,WoW:wow,StarCraft II:sc2,Brawl Stars:bs,Clash Royale:cr,Clash of Clans:coc,World of Tanks:wot,Chess.com:chess,Chess:chess,Lichess:lichess,osu!:osu,Hypixel:hypixel,Minecraft:hypixel,World of Warships:wows,World of Tanks Blitz:wotb,WoT Blitz:wotb,Path of Exile 2:poe2,PoE2:poe2,Rust:rust,Team Fortress 2:tf2,TF2:tf2' | split: ','
    for gp in glist
      assign kv = gp | split: ':'
      assign gfrom = '<p class="rs-post__meta">' | append: kv[0] | append: '</p>'
      assign gto = '<p class="rs-post__meta" data-g="' | append: kv[1] | append: '">' | append: kv[0] | append: '</p>'
      assign body = body | replace: gfrom, gto
    endfor
  endif
-%}
<section class="rs-hero">
  {%- if hero != blank -%}
    {{ hero | image_url: width: 2400 | image_tag: class: 'rs-hero__img', widths: '640, 960, 1280, 1600, 1920, 2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: hero_alt }}
  {%- elsif hero_svg != '' -%}
    <img class="rs-hero__img" src="{{ hero_svg | asset_url }}" alt="{{ hero_alt | escape }}" width="1600" height="640" loading="eager" fetchpriority="high">
  {%- endif -%}
  <div class="rs-wrap rs-hero__in">
    <nav class="rs-crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / <span aria-current="page">{{ page.title }}</span></nav>
    <h1>{{ page.title }}</h1>
    {%- if sub != blank -%}<p class="rs-hero__sub">{{ sub }}</p>{%- endif -%}
  </div>
</section>
{% render 'rs-share' %}
{%- comment -%} v54: guides-only hubs never show a lookup box. If the page body has no "Guides only" callout of its own, this honest notice is shown instead. {%- endcomment -%}
{%- liquid
  assign go_name = ''
  case page.handle
    when 'valorant-stats'
      assign go_name = 'Valorant'
      assign go_tag = 'valorant'
      assign go_why = 'Riot only allows Valorant data for players who opt in, so there is no public Valorant player lookup.'
    when 'overwatch-2-stats'
      assign go_name = 'Overwatch 2'
      assign go_tag = 'overwatch-2'
      assign go_why = 'Blizzard has no official public Overwatch stats API, so there is no Overwatch 2 player lookup.'
    when 'marvel-rivals-stats'
      assign go_name = 'Marvel Rivals'
      assign go_tag = 'marvel-rivals'
      assign go_why = 'NetEase has no official Marvel Rivals API, so there is no Marvel Rivals player lookup.'
  endcase
-%}
{%- if go_name != '' and page.content contains 'Guides only' -%}{%- assign go_name = '' -%}{%- endif -%}
{%- if go_name != '' -%}
<div class="rs-wrap"><div class="rs-callout rs-callout--soon rs-guideonly" role="note"><p><strong>{{ go_name }} is guides only on RankSurge.</strong> {{ go_why }} You get rank guides, stat explainers and climbing guides instead.</p><p class="rs-pend__cta"><a class="rs-btn" href="/blogs/news/tagged/{{ go_tag }}">Read the {{ go_name }} guides</a> <a class="rs-btn rs-btn--ghost" href="/pages/ranks-explained">All ranks explained</a> <a class="rs-btn rs-btn--ghost" href="/pages/player-lookup">Games with live lookups</a></p></div></div>
{%- endif -%}
{% render 'rs-ad-slot', placement: 'sponsor' %}
{% render 'rs-ad-slot', placement: 'banner' %}
{%- for block in section.blocks -%}
  {%- if block.type == 'dashboard' -%}{% render 'rs-dashboard' %}{%- endif -%}
  {%- if block.type == 'lookup' -%}{%- unless 'valorant-stats,overwatch-2-stats,marvel-rivals-stats' contains page.handle -%}{% render 'rs-lookup' %}{%- endunless -%}{%- endif -%}
  {%- if block.type == 'contact' -%}
    <section class="rs-look" aria-labelledby="rs-cf-h"><div class="rs-wrap"><div class="rs-look__box">
      <h2 id="rs-cf-h" class="rs-look__h">Send us a message</h2>
      {%- form 'contact', class: 'rs-form' -%}
        {%- if form.posted_successfully? -%}<p class="rs-ok" role="status">Thanks. We got your message and will reply by email.</p>{%- endif -%}
        {%- if form.errors -%}<p class="rs-err" role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="rs-form__row"><label for="cf-name">Name</label><input id="cf-name" name="contact[name]" autocomplete="name" value="{{ form.name }}"></div>
        <div class="rs-form__row"><label for="cf-email">Email</label><input id="cf-email" type="email" name="contact[email]" autocomplete="email" required value="{{ form.email }}"></div>
        <div class="rs-form__row"><label for="cf-topic">Topic</label><select id="cf-topic" name="contact[topic]"><option>General question</option><option>Data or profile issue</option><option>Privacy or data deletion</option><option>Partnerships</option></select></div>
        <div class="rs-form__row"><label for="cf-msg">Message</label><textarea id="cf-msg" name="contact[body]" rows="6" required>{{ form.body }}</textarea></div>
        <button class="rs-btn" type="submit">Send message</button>
      {%- endform -%}
    </div></div></section>
  {%- endif -%}
{%- endfor -%}
