{%- liquid
  # v53: Ask RankSurge AI coach (Worker v19 /v1/help) on game pages, pages with custom.about_game, game tool pages and the Player Hub.
  assign help_on = false
  assign help_g = hubg
  if hubg != ''
    assign help_on = true
  endif
  if page.metafields.custom.about_game.value != blank
    assign help_on = true
    if help_g == ''
      assign help_g = page.metafields.custom.about_game.value
    endif
  endif
  case page.handle
    when 'wow-leaderboards'
      assign help_on = true
      assign help_g = 'wow'
    when 'dota-2-hero-tier-list'
      assign help_on = true
      assign help_g = 'dota-2'
    when 'cs2-inventory-value', 'cs2-pro-comparisons'
      assign help_on = true
      assign help_g = 'cs2'
    when 'destiny-2-vault-manager'
      assign help_on = true
      assign help_g = 'destiny-2'
    when 'player-hub'
      assign help_on = true
      assign help_g = ''
  endcase
-%}
