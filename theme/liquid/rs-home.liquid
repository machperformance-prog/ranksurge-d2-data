{%- liquid
  # v57: hero emblem. Source: the editor's "Hero image" setting (any aspect ratio, shown contained), else Files: ranksurge-home-emblem.png,
  # else the old portrait art (ranksurge-home-hero.png), else the rs-climb graphic.
  assign hero_src = section.settings.hero_image
  if hero_src == blank
    assign hero_src = images['ranksurge-home-emblem.png']
  endif
  assign home_art = images['ranksurge-home-hero.png']
  assign emb_alt = section.settings.hero_alt
  if emb_alt contains 'Neon esports arena'
    assign emb_alt = ''
  endif
  # v60: never show an old alt that mentions boosting (RankSurge is a stats site); fall back to a neutral description.
  assign alt_chk = emb_alt | downcase
  if alt_chk contains 'boost'
    assign emb_alt = ''
  endif
  if hero_src != blank
    assign alt_chk = hero_src.alt | downcase
    if emb_alt == blank and alt_chk contains 'boost'
      assign emb_alt = 'RankSurge logo with a rising rank arrow and rank emblems'
    endif
    assign emb_alt = emb_alt | default: hero_src.alt | default: 'RankSurge logo with a rising rank arrow and rank emblems'
  endif
  assign art_alt = home_art.alt
  assign alt_chk = art_alt | downcase
  if alt_chk contains 'boost'
    assign art_alt = ''
  endif
  assign art_alt = art_alt | default: 'RankSurge neon logo art: a glowing cyan and violet rank emblem'
-%}
{%- liquid
  # v59/v60: hero game picker. Six popular live games as chips (two of them hide on phones) plus an "All games" chip that opens a grid
  # of every game. v60: Worker v21 games (StarCraft II, Brawl Stars, Clash Royale, Clash of Clans) render as LIVE as soon as their page
  # exists (same rule as snippets/rs-live-games). The script below only downgrades one if /health reports its flag as false.
  # v69: hh_new is split on commas, so the tile captions (6th field) must never contain a comma.
  assign hh_new = 'sc2|StarCraft II|StarCraft II|Profile link or region/realm/id|starcraft-2-stats|Top 200 ladder,bs|Brawl Stars|Brawl Stars|Player tag (e.g. #2PP0YQ)|brawl-stars-stats|Club board,cr|Clash Royale|Clash Royale|Player tag (e.g. #9CQ2U8QJ)|clash-royale-stats|Deck and clan board,coc|Clash of Clans|Clash of Clans|Player tag (e.g. #P0LYJC8C)|clash-of-clans-stats|Clan board,wot|World of Tanks|World of Tanks|Exact player name|world-of-tanks-stats|Most played tanks,chess|Chess.com|Chess.com|Chess.com username|chess-stats|Recent games and openings,lichess|Lichess|Lichess|Lichess username|lichess-stats|Recent games and openings,osu|osu!|osu!|osu! username|osu-stats|Top 10 plays,hypixel|Hypixel|Hypixel|Minecraft username|hypixel-stats|Bed Wars · SkyWars · Duels,wows|World of Warships|World of Warships|Exact player name|world-of-warships-stats|Most played ships,wotb|WoT Blitz|World of Tanks Blitz|Exact player name|world-of-tanks-blitz-stats|Most played tanks,fortnite|Fortnite|Fortnite|Epic display name|fortnite-stats|Solo · Duos · Squads,rust|Rust|Rust|Steam profile link or SteamID64|rust-stats|K/D · headshots · hit rate|hub,tf2|Team Fortress 2|TF2|Steam profile link or SteamID64|tf2-stats|Class playtime · kills · records|hub' | split: ','
  assign hh_n = 11
  assign hh_live = 6
  assign hh_list = 'Deadlock|CS2|Dota 2|Destiny 2|PUBG|World of Warcraft'
  assign hh_keys = '|||||'
  assign hh_aip_list = 'Deadlock|CS2|Dota 2|PUBG|Destiny 2|World of Warcraft'
  # v73: games whose lookups need an API key that is not added yet (World of Tanks, osu!, Hypixel, World of Warships, WoT Blitz)
  # come back from rs-live-games mode 'pend' as ",key,key,". They render under Coming soon; the script below moves one to Live
  # only when /health reports it on (flag true or listed in games). Rust and TF2 (Steam) are live like the other Worker games.
  capture hh_pend
    render 'rs-live-games', mode: 'pend'
  endcapture
  assign hh_pend = hh_pend | strip
  assign hh_soon = ''
  for x in hh_new
    assign xp = x | split: '|'
    assign xk = ',' | append: xp[0] | append: ','
    if pages[xp[4]].handle != blank
      assign hh_n = hh_n | plus: 1
      if hh_pend contains xk
        assign hh_soon = hh_soon | append: '|' | append: xp[1]
      else
        assign hh_live = hh_live | plus: 1
        assign hh_list = hh_list | append: '|' | append: xp[1]
        assign hh_keys = hh_keys | append: '|' | append: xp[0]
        # v68: Fortnite has no AI Profile Pick support in the Worker yet (CMP_KEYS), so it is not named as an AI Pick game. v73: nor Rust or TF2.
        unless xp[0] == 'fortnite' or xp[0] == 'rust' or xp[0] == 'tf2'
          assign hh_aip_list = hh_aip_list | append: '|' | append: xp[1]
        endunless
      endif
    endif
  endfor
  # v73: Path of Exile 2 is guides only (no lookups until Grinding Gear Games reopens developer applications).
  assign hh_poe2 = false
  if pages['path-of-exile-2-stats'].handle != blank
    assign hh_poe2 = true
    assign hh_n = hh_n | plus: 1
  endif
  assign hh_soon_a = hh_soon | remove_first: '|' | split: '|'
  capture hh_soon_sent
    for g in hh_soon_a
      if forloop.first
        echo g
      elsif forloop.last
        echo ' and ' | append: g
      else
        echo ', ' | append: g
      endif
    endfor
  endcapture
  assign hh_soon_sent = hh_soon_sent | strip
  capture hh_sent
    render 'rs-live-games', names: 'mixed'
  endcapture
  assign hh_sent = hh_sent | strip
  assign hh_aip = hh_aip_list | split: '|'
  capture hh_aip_sent
    for g in hh_aip
      if forloop.first
        echo g
      elsif forloop.last
        echo ' and ' | append: g
      else
        echo ', ' | append: g
      endif
    endfor
  endcapture
  assign nw = 'Six,Seven,Eight,Nine,Ten,Eleven,Twelve,Thirteen,Fourteen,Fifteen,Sixteen,Seventeen,Eighteen,Nineteen,Twenty' | split: ','
  assign nw_i = hh_live | minus: 6
  assign hh_live_w = nw[nw_i] | default: hh_live
  assign hh_api = shop.metafields.ranksurge.stats_api_base.value | default: shop.metafields.ranksurge.stats_api_base
-%}
<style>
/* v59: hero game picker that scales to 10+ live games. Six live chips (Dota 2 and Destiny 2 hide on phones) plus a compact
   "All games" chip that opens an inline grid of every game, grouped Live / Coming soon / Guides only. */
.rs-hh__chips{display:contents}
.rs-hh__all{gap:8px;border-style:solid;border-color:color-mix(in srgb,var(--rs-violet-soft,#B57BFF) 60%,var(--rs-border));color:#fff}
.rs-hh__all .rs-ico{color:var(--rs-violet-soft,#B57BFF)}
.rs-hh__all[aria-expanded="true"],.rs-hh__all.is-pick{border-color:var(--rs-cyan,#00E5FF);background:color-mix(in srgb,var(--rs-cyan,#00E5FF) 12%,var(--rs-bg))}
.rs-hh__all::after{content:"";width:8px;height:8px;margin-left:2px;border-right:2px solid currentColor;border-bottom:2px solid currentColor;transform:rotate(45deg) translate(-2px,-2px);transition:transform .15s}
.rs-hh__all[aria-expanded="true"]::after{transform:rotate(225deg) translate(-2px,-2px)}
.rs-hh__grid{display:grid;gap:8px;max-width:600px;margin:12px 0 0;padding:14px;border-radius:16px;background:rgba(17,19,24,.96);border:1px solid rgba(181,123,255,.35);box-shadow:0 12px 32px rgba(0,0,0,.5)}
.rs-hh__grid[hidden]{display:none}
.rs-hh__gl{display:flex;align-items:center;gap:8px;margin:4px 0 0;font:700 13px/1.2 var(--rs-body);letter-spacing:.12em;text-transform:uppercase;color:#C9CED8}
.rs-hh__gl:first-child{margin-top:0}
.rs-hh__gn{margin-left:auto;padding:2px 8px;border-radius:999px;background:rgba(255,255,255,.08);font:700 12px/1.3 var(--rs-body);letter-spacing:0;color:#fff}
.rs-hh__gl b{width:8px;height:8px;border-radius:50%}.rs-hh__gl b.is-live{background:var(--rs-gain)}.rs-hh__gl b.is-soon{background:#FFB020}.rs-hh__gl b.is-guide{background:var(--rs-cyan)}
.rs-hh__gg{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px}
.rs-hh__gg:empty,.rs-hh__gg:empty+.rs-hh__gl{display:none}
.rs-hh__grid .rs-chip{justify-content:flex-start;width:100%;min-height:44px;padding:8px 12px;font-size:15px;border-radius:12px}
.rs-hh__grid .rs-chip span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
@media (max-width:640px){.rs-hh__chips [data-pri="2"]{display:none}.rs-hh__gg{grid-template-columns:repeat(2,minmax(0,1fr))}.rs-hh__grid{padding:12px}}
@media (prefers-reduced-motion:reduce){.rs-hh__all::after{transition:none}}
/* v73 accents */
.g-poe2{--g:#E0A040}.g-rust{--g:#E8743B}.g-tf2{--g:#E0523A}

/* v80: Marathon accent */
.g-marathon{--g:#C8FF2E}
/* v77: Destiny 2 database announcement on the game tile */
.rs-game__new{display:flex;align-items:flex-start;gap:8px;margin:8px 0 2px;padding:8px 10px;border-radius:8px;border:1px solid rgba(0,229,255,.45);background:rgba(0,229,255,.08);color:#E6FBFF!important;font:600 15px/1.35 var(--rs-body);text-decoration:none}.rs-game__new:hover{border-color:var(--rs-cyan);box-shadow:0 0 14px rgba(0,229,255,.25)}.rs-game__new b{flex:none;padding:1px 7px;border-radius:5px;background:var(--rs-cyan);color:#08090C;font:700 13px/1.5 var(--rs-display);letter-spacing:.04em;text-transform:uppercase}
</style>
<section data-api="{{ hh_api | escape }}" class="rs-hh{% if hero_src != blank %} rs-hh--emblem{% elsif home_art != blank %} rs-hh--art{% endif %}">
  <div class="rs-wrap rs-hh__in">
    <div>
      <h1>The Free Game Stats Tracker for Competitive Players</h1>
      <p class="rs-hh__sub">Rank history, match reports and AI comparisons, free in your browser with no Overwolf. Live player lookups for <span data-hf-sent data-list="{{ hh_list }}" data-keys="{{ hh_keys }}">{{ hh_sent }}</span>.</p>
      <div class="rs-look__games rs-hh__games"><div class="rs-hh__chips" role="radiogroup" aria-label="Game"><button type="button" role="radio" aria-checked="true" class="rs-chip g-deadlock" data-g="deadlock" data-name="Deadlock" data-fmt="Steam profile link or SteamID64">{% render 'rs-icon', name: 'deadlock' %}<span>Deadlock</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip g-counter-strike-2" data-g="counter-strike-2" data-name="CS2" data-fmt="Steam profile link or SteamID64">{% render 'rs-icon', name: 'counter-strike-2' %}<span>CS2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip g-dota-2" data-g="dota-2" data-name="Dota 2" data-pri="2" data-fmt="Steam name or friend ID">{% render 'rs-icon', name: 'dota-2' %}<span>Dota 2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip g-pubg" data-g="pubg" data-name="PUBG" data-fmt="Exact in-game name (case-sensitive)">{% render 'rs-icon', name: 'pubg' %}<span>PUBG</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip g-destiny-2" data-g="destiny-2" data-name="Destiny 2" data-pri="2" data-fmt="Bungie Name (Name#1234)">{% render 'rs-icon', name: 'destiny-2' %}<span>Destiny 2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip g-wow" data-g="wow" data-name="World of Warcraft" data-fmt="Character-Realm (e.g. Name-Stormrage)">{% render 'rs-icon', name: 'wow' %}<span>WoW</span></button></div><button type="button" class="rs-chip rs-hh__all" id="rs-hh-allb" aria-expanded="false" aria-controls="rs-hh-all" data-lbl="All {{ hh_n }} games"><svg class="rs-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg><span>All {{ hh_n }} games</span></button></div>
      <div class="rs-hh__grid" id="rs-hh-all" role="group" aria-label="All games" hidden><p class="rs-hh__gl" id="rs-hh-gl1"><b class="is-live" aria-hidden="true"></b>Live lookups <span class="rs-hh__gn" data-live-c>{{ hh_live }}</span></p><div class="rs-hh__gg" role="radiogroup" aria-labelledby="rs-hh-gl1" data-gg="live"><button type="button" role="radio" aria-checked="true" class="rs-chip rs-hh__gb g-deadlock" data-g="deadlock" data-name="Deadlock" data-fmt="Steam profile link or SteamID64">{% render 'rs-icon', name: 'deadlock' %}<span>Deadlock</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-counter-strike-2" data-g="counter-strike-2" data-name="CS2" data-fmt="Steam profile link or SteamID64">{% render 'rs-icon', name: 'counter-strike-2' %}<span>CS2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-dota-2" data-g="dota-2" data-name="Dota 2" data-pri="2" data-fmt="Steam name or friend ID">{% render 'rs-icon', name: 'dota-2' %}<span>Dota 2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-pubg" data-g="pubg" data-name="PUBG" data-fmt="Exact in-game name (case-sensitive)">{% render 'rs-icon', name: 'pubg' %}<span>PUBG</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-destiny-2" data-g="destiny-2" data-name="Destiny 2" data-pri="2" data-fmt="Bungie Name (Name#1234)">{% render 'rs-icon', name: 'destiny-2' %}<span>Destiny 2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-wow" data-g="wow" data-name="World of Warcraft" data-fmt="Character-Realm (e.g. Name-Stormrage)">{% render 'rs-icon', name: 'wow' %}<span>WoW</span></button>{%- for x in hh_new -%}{%- assign xp = x | split: '|' -%}{%- assign xk = ',' | append: xp[0] | append: ',' -%}{%- if pages[xp[4]].handle != blank -%}{%- unless hh_pend contains xk -%}<button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb g-{{ xp[0] }}" data-g="{{ xp[0] }}" data-hf="{{ xp[0] }}"{% if xp[6] == 'hub' %} data-act="/pages/{{ xp[4] }}"{% endif %} data-name="{{ xp[1] }}" data-fmt="{{ xp[3] }}" data-href="/pages/{{ xp[4] }}" data-link="Read about {{ xp[1] }} on RankSurge">{% render 'rs-icon', name: xp[0] %}<span>{{ xp[2] }}</span></button>{%- endunless -%}{%- endif -%}{%- endfor -%}</div><p class="rs-hh__gl" id="rs-hh-gl2"><b class="is-soon" aria-hidden="true"></b>Coming soon</p><div class="rs-hh__gg" role="radiogroup" aria-labelledby="rs-hh-gl2" data-gg="soon"><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-league-of-legends" data-g="league-of-legends" data-off="League of Legends lookups open after Riot approval." data-href="/pages/league-of-legends-stats" data-link="Read the League of Legends guides" data-name="League">{% render 'rs-icon', name: 'league-of-legends' %}<span>League</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-tft" data-g="tft" data-off="TFT lookups open after Riot approval." data-href="/pages/tft-stats" data-link="Read the TFT guides" data-name="TFT">{% render 'rs-icon', name: 'tft' %}<span>TFT</span></button>{%- for x in hh_new -%}{%- assign xp = x | split: '|' -%}{%- assign xk = ',' | append: xp[0] | append: ',' -%}{%- if pages[xp[4]].handle != blank and hh_pend contains xk -%}<button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-{{ xp[0] }}" data-g="{{ xp[0] }}" data-hk="{{ xp[0] }}" data-name="{{ xp[1] }}" data-fmt="{{ xp[3] }}" data-off="{{ xp[1] }} lookups are coming soon." data-href="/pages/{{ xp[4] }}" data-link="Read about {{ xp[1] }} on RankSurge">{% render 'rs-icon', name: xp[0] %}<span>{{ xp[2] }}</span></button>{%- endif -%}{%- endfor -%}</div><p class="rs-hh__gl" id="rs-hh-gl3"><b class="is-guide" aria-hidden="true"></b>Guides only</p><div class="rs-hh__gg" role="radiogroup" aria-labelledby="rs-hh-gl3" data-gg="guide"><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-valorant" data-g="valorant" data-guide="1" data-off="Valorant is guides only: Riot does not allow public Valorant player lookups." data-href="/pages/valorant-stats" data-link="Read the Valorant rank guides" data-name="Valorant">{% render 'rs-icon', name: 'valorant' %}<span>Valorant</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-overwatch-2" data-g="overwatch-2" data-guide="1" data-off="Overwatch 2 is guides only: Blizzard has no official public Overwatch stats API." data-href="/pages/overwatch-2-stats" data-link="Read the Overwatch 2 rank guides" data-name="Overwatch 2">{% render 'rs-icon', name: 'overwatch-2' %}<span>Overwatch 2</span></button><button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-marvel-rivals" data-g="marvel-rivals" data-guide="1" data-off="Marvel Rivals is guides only: NetEase has no official Marvel Rivals API." data-href="/pages/marvel-rivals-stats" data-link="Read the Marvel Rivals rank guides" data-name="Marvel Rivals">{% render 'rs-icon', name: 'marvel-rivals' %}<span>Rivals</span></button>{%- if hh_poe2 -%}<button type="button" role="radio" aria-checked="false" class="rs-chip rs-hh__gb rs-chip--off g-poe2" data-g="poe2" data-guide="1" data-off="Path of Exile 2 is guides only for now: player lookups open when Grinding Gear Games reopens developer applications." data-href="/pages/path-of-exile-2-stats" data-link="Open the Path of Exile 2 hub" data-name="Path of Exile 2">{% render 'rs-icon', name: 'poe2' %}<span>PoE 2</span></button>{%- endif -%}</div></div>
      <form class="rs-hh__form" action="/pages/player-lookup" method="get" role="search">
        <input type="hidden" name="g" value="deadlock">
        <label class="rs-sr" for="rs-home-q">Player ID</label>
        <input id="rs-home-q" name="q" type="search" placeholder="Steam profile link or SteamID64" autocomplete="off" required>
        <button class="rs-btn" type="submit">{% render 'rs-icon', name: 'search' %}Search</button>
      </form>
      <p class="rs-hh__off" id="rs-home-off" role="status" aria-live="polite" hidden></p>
      <p class="rs-hh__note">Live now: <a href="/pages/deadlock-stats">Deadlock</a>, <a href="/pages/cs2-stats">CS2</a>, <a href="/pages/dota-2-stats">Dota 2</a>, <a href="/pages/destiny-2-stats">Destiny 2</a>, <a href="/pages/pubg-stats">PUBG</a>, <a href="/pages/wow-stats">World of Warcraft</a>{%- for x in hh_new -%}{%- assign xp = x | split: '|' -%}{%- assign xk = ',' | append: xp[0] | append: ',' -%}{%- if pages[xp[4]].handle != blank -%}{%- unless hh_pend contains xk -%}<span data-hf-i="{{ xp[0] }}">, <a href="/pages/{{ xp[4] }}">{{ xp[1] }}</a></span>{%- endunless -%}{%- endif -%}{%- endfor -%}, plus the <a href="/pages/destiny-2-vault-manager">Destiny 2 vault manager</a> and <a href="/pages/wow-leaderboards">WoW leaderboards</a>. League of Legends and TFT open after Riot approval.</p>
    </div>
    <div class="rs-hh__art{% if hero_src != blank %} rs-hh__art--emb{% elsif home_art != blank %} rs-hh__art--pic{% endif %}">{%- if hero_src != blank -%}{{ hero_src | image_url: width: 1600 | image_tag: class: 'rs-hh__emb', widths: '400, 600, 800, 1024, 1280, 1600', sizes: '(max-width: 960px) min(420px, 88vw), min(620px, 50vw)', loading: 'eager', fetchpriority: 'high', alt: emb_alt }}{%- elsif home_art != blank -%}{{ home_art | image_url: width: 848 | image_tag: class: 'rs-hh__pic', widths: '300, 400, 600, 848', sizes: '(max-width: 640px) 242px, (max-width: 960px) 300px, 410px', loading: 'eager', fetchpriority: 'high', alt: art_alt }}{%- else -%}{% render 'rs-climb' %}{%- endif -%}</div>
  </div>
</section>
<section class="rs-sec rs-aip"><div class="rs-wrap"><a class="rs-aip__card" href="/pages/compare-players">
  <div class="rs-aip__vs" aria-hidden="true"><span class="a">A</span><b>VS</b><span class="b">B</span></div>
  <div class="rs-aip__txt"><p class="rs-aip__k"><i>AI</i> RankSurge signature tool</p><h2>AI Profile Pick</h2><p>Enter two players. Our AI picks the stronger profile and tells you why, in seconds. Live for <span data-hf-sent data-list="{{ hh_aip_list }}" data-keys="{{ hh_keys }}">{{ hh_aip_sent | strip }}</span>.</p></div>
  <span class="rs-aip__go">Try it free {% render 'rs-icon', name: 'arrow-right' %}</span>
</a></div></section>
{%- if hero_src != blank -%}
<style>
/* v57 hero emblem: contained in the normal two-column hero (inside the 1160px wrap). Flat page background, a soft violet glow
   behind the emblem that stays inside its column, a 4% edge feather, no cropping. <=960px: stacked, emblem centred below the search. */
.rs-hh--emblem{background:var(--rs-bg)}
.rs-hh--emblem::before,.rs-hh--emblem::after{display:none}
.rs-hh--emblem .rs-hh__in{grid-template-columns:minmax(0,1fr) min(620px,50%);gap:28px;align-items:center}
.rs-hh__art--emb{position:relative;display:flex;justify-content:center;align-items:center;isolation:isolate;min-width:0}
.rs-hh__art--emb::before{content:"";position:absolute;inset:6%;z-index:-1;border-radius:50%;background:radial-gradient(closest-side,rgba(138,43,226,.26),rgba(0,229,255,.07) 62%,transparent 100%);pointer-events:none}
.rs-hh__emb{display:block;width:100%;height:auto;max-width:100%;object-fit:contain;
  -webkit-mask-image:linear-gradient(to right,transparent 0,#000 4%,#000 96%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 4%,#000 96%,transparent 100%);-webkit-mask-composite:source-in;
  mask-image:linear-gradient(to right,transparent 0,#000 4%,#000 96%,transparent 100%),linear-gradient(to bottom,transparent 0,#000 4%,#000 96%,transparent 100%);mask-composite:intersect}
@media (max-width:960px){
  .rs-hh--emblem .rs-hh__in{grid-template-columns:minmax(0,1fr);gap:28px}
  .rs-hh__art--emb .rs-hh__emb{width:min(420px,88vw)}
}
