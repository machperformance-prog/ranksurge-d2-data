<script>
(function(){var r=document.querySelector('.rs-hh');if(!r)return;var q=document.getElementById('rs-home-q'),g=r.querySelector('input[name=g]'),f=r.querySelector('.rs-hh__form'),sb=f.querySelector('button[type=submit]'),off=document.getElementById('rs-home-off'),allb=document.getElementById('rs-hh-allb'),grid=document.getElementById('rs-hh-all');
function esc(s){return String(s).replace(/[&<>"]/g,function(m){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[m];});}
function btns(){return [].slice.call(r.querySelectorAll('.rs-hh__chips [data-g],.rs-hh__grid [data-g]'));}
function setAll(open){if(!grid||!allb)return;grid.hidden=!open;allb.setAttribute('aria-expanded',String(open));}
function label(b){if(!allb)return;var sp=allb.querySelector('span'),k=b.dataset.g,vis=[].slice.call(r.querySelectorAll('.rs-hh__chips [data-g]')).some(function(x){return x.dataset.g===k&&x.offsetParent!==null;});
if(vis){sp.textContent=allb.dataset.lbl;allb.classList.remove('is-pick');allb.removeAttribute('aria-label');}else{sp.textContent=b.dataset.name||b.textContent.trim();allb.classList.add('is-pick');allb.setAttribute('aria-label',allb.dataset.lbl+', '+(b.dataset.name||'')+' selected');}}
function choose(b,focus){var k=b.dataset.g;btns().forEach(function(x){x.setAttribute('aria-checked',String(x.dataset.g===k));});label(b);
if(b.dataset.off){q.value='';q.disabled=true;sb.disabled=true;f.classList.add('is-off');q.placeholder=b.dataset.name+(b.dataset.guide?': guides only':': not open yet');off.innerHTML=esc(b.dataset.off)+' <a href="'+esc(b.dataset.href)+'">'+esc(b.dataset.link)+'</a>';off.hidden=false;return;}
q.disabled=false;sb.disabled=false;f.classList.remove('is-off');off.hidden=true;q.placeholder=b.dataset.fmt;g.value=k;f.setAttribute('action',b.dataset.act||'/pages/player-lookup');if(focus)q.focus();}
r.addEventListener('click',function(e){var b=e.target.closest?e.target.closest('[data-g]'):null;if(b&&r.contains(b)&&(b.closest('.rs-hh__chips')||b.closest('.rs-hh__grid'))){var inGrid=!!b.closest('.rs-hh__grid');choose(b,true);if(inGrid){setAll(false);if(b.dataset.off)allb.focus();}return;}
if(e.target.closest&&e.target.closest('#rs-hh-allb')){var open=grid.hidden;setAll(open);if(open){var c=grid.querySelector('[aria-checked="true"]')||grid.querySelector('[data-g]');if(c)c.focus();}}});
if(grid)grid.addEventListener('keydown',function(e){if(e.key==='Escape'){setAll(false);allb.focus();}});
window.addEventListener('resize',function(){var c=r.querySelector('.rs-hh__chips [aria-checked="true"]')||grid&&grid.querySelector('[aria-checked="true"]');if(c)label(c);});
/* v60: Worker v21 games render live once their page exists. /health can only DOWNGRADE one whose flag is exactly false
   (e.g. switched off for maintenance); a failed or missing /health never hides a live game. */
var NW=['Six','Seven','Eight','Nine','Ten','Eleven','Twelve','Thirteen','Fourteen','Fifteen','Sixteen','Seventeen','Eighteen','Nineteen','Twenty'],api=String(r.getAttribute('data-api')||'').replace(/\/$/,'');
function down(k){[].forEach.call(document.querySelectorAll('[data-hf="'+k+'"]'),function(el){if(el.tagName==='BUTTON'){el.classList.add('rs-chip--off');el.setAttribute('data-off',(el.dataset.name||'')+' lookups are paused right now. Please check back soon.');var sg=grid&&grid.querySelector('[data-gg="soon"]');if(sg)sg.insertBefore(el,sg.firstChild);}else{el.classList.remove('is-live');el.classList.add('is-soon');var s=el.querySelector('[data-hf-s]');if(s)s.textContent='Paused for now';var su=document.querySelector('[data-gg-soon]');if(su)su.insertBefore(el,su.firstChild);}});
[].forEach.call(document.querySelectorAll('[data-hf-i="'+k+'"]'),function(el){el.parentNode.removeChild(el);});}
/* v73: games waiting on an API key (data-hk) start under Coming soon and move to Live only when /health reports them on
   (flag exactly true, or listed in games). A missing flag or a failed /health leaves them as Coming soon. */
function up(k){[].forEach.call(document.querySelectorAll('[data-hk="'+k+'"]'),function(el){if(el.tagName==='BUTTON'){el.classList.remove('rs-chip--off');el.removeAttribute('data-off');var lg=grid&&grid.querySelector('[data-gg="live"]');if(lg)lg.appendChild(el);}else{el.classList.remove('is-soon');el.classList.add('is-live');var s=el.querySelector('[data-hf-s]');if(s)s.textContent='Live lookups';var lu=document.querySelector('[data-gg-live]');if(lu)lu.appendChild(el);}});}
if(api&&document.querySelector('[data-hf],[data-hk]'))fetch(api+'/health',{credentials:'omit'}).then(function(x){return x.ok?x.json():null;}).then(function(h){if(!h||typeof h!=='object')return;var gone={},ng=0,ups={},nu=0,hg=Array.isArray(h.games)?h.games:[];
[].forEach.call(document.querySelectorAll('.rs-hh__grid [data-hf]'),function(b){var k=b.dataset.hf;if(h[k]===false&&!gone[k]){gone[k]=1;ng++;}});
[].forEach.call(document.querySelectorAll('.rs-hh__grid [data-hk]'),function(b){var k=b.dataset.hk;if(!ups[k]&&h[k]!==false&&(h[k]===true||hg.indexOf(k)>-1)){ups[k]=1;nu++;}});
if(!ng&&!nu)return;Object.keys(gone).forEach(down);Object.keys(ups).forEach(up);
if(nu)[].forEach.call(document.querySelectorAll('[data-soon-s]'),function(el){el.parentNode.removeChild(el);});
var lc=document.querySelector('[data-live-c]'),n=(lc?+lc.textContent:6)-ng+nu;if(lc)lc.textContent=n;
[].forEach.call(document.querySelectorAll('[data-live-n]'),function(el){el.textContent=NW[n-6]||String(n);});
[].forEach.call(document.querySelectorAll('[data-hf-sent]'),function(el){var L=String(el.getAttribute('data-list')||'').split('|'),K=String(el.getAttribute('data-keys')||'').split('|'),l=L.filter(function(x,i){return x&&!gone[K[i]];});if(l.length)el.textContent=l.length>1?l.slice(0,-1).join(', ')+' and '+l[l.length-1]:l[0];});
var c=r.querySelector('.rs-hh__grid [aria-checked="true"]')||r.querySelector('[aria-checked="true"]');if(c)choose(c,false);}).catch(function(){});})();
</script>
