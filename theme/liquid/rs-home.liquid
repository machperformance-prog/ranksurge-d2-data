    {%- if a.image -%}{%- capture bg -%}url('{{ a.image | image_url: width: 900 }}'){%- endcapture -%}{%- else -%}{%- assign bg = 'linear-gradient(135deg,#0B1A2E,var(--g,#00E5FF) 55%,#7B2FF7)' -%}{%- endif -%}
