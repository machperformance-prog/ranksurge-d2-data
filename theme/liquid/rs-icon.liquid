      assign p = '<path d="M21 8.5L12 3 3 8.5v7L12 21l9-5.5z"/><path d="M3 8.5l9 5.5 9-5.5M12 14v7"/><path d="M7.5 5.8l9 5.5"/>'
    else
      assign p = '<path d="M12 2l3 7h7l-5.5 4.5 2 7.5L12 16.5 5.5 21l2-7.5L2 9h7z"/>'
  endcase
  assign px = size | plus: 0
  if px < 12
    assign px = 24
  endif
  assign use_img = false
  if img != ''
    assign icon_file = images[img]
    if icon_file != blank
      assign use_img = true
    endif
  endif
-%}
{%- if use_img -%}
{%- liquid
  assign s1 = px | times: 2
  assign s2 = px | times: 4 | at_most: 1024
  assign s3 = px | times: 6 | at_most: 1024
-%}
<img class="rs-ico rs-ico--img{% if class %} {{ class }}{% endif %}" src="{{ icon_file | image_url: width: s1 }}" srcset="{{ icon_file | image_url: width: s1 }} 1x, {{ icon_file | image_url: width: s2 }} 2x, {{ icon_file | image_url: width: s3 }} 3x" width="{{ px }}" height="{{ px }}" alt="" loading="lazy" decoding="async">
{%- else -%}
<svg class="rs-ico{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24"{% if size %} width="{{ px }}" height="{{ px }}"{% endif %} aria-hidden="true" focusable="false">{{ p }}</svg>
{%- endif -%}
