{%- comment -%} v77: Destiny 2 tools hub strip for the D2 pages that are not database pages (stats tracker, vault manager). Same look as the hub in assets/rs-d2db.js. {%- endcomment -%}
{{ 'rs-d2db.css' | asset_url | stylesheet_tag }}
<div class="rsd2 d2-hubwrap"><div class="rs-wrap"><nav class="d2-hub" aria-label="Destiny 2 tools">
{%- assign t = 'destiny-2-weapons|Weapons database|<circle cx="12" cy="12" r="7.5"/><circle cx="12" cy="12" r="2.5"/>,destiny-2-armor|Armor database|<path d="M5 14a7 7 0 0 1 14 0v3H5z"/><path d="M9 17v3M15 17v3M8 12h8"/>,destiny-2-build-planner|Build planner|<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><path d="M17 14v6M14 17h6"/>,destiny-2-best-weapons-and-armor|Best weapons & armor|<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 6H5a3 3 0 0 0 3 4M16 6h3a3 3 0 0 1-3 4M12 13v4M8 21h8M9 17h6"/>,destiny-2-vault-manager|Vault manager|<rect x="3.5" y="4.5" width="17" height="15" rx="2"/><circle cx="12" cy="12" r="3.5"/><path d="M12 8.5V7M12 17v-1.5M15.5 12H17M7 12h1.5"/>,destiny-2-stats|Stats tracker|<path d="M4 20h16"/><path d="M7 16v-5M12 16V6M17 16v-8"/>,player-hub|Player hub|<circle cx="9" cy="8" r="3.5"/><path d="M2.5 20a6.5 6.5 0 0 1 13 0"/><path d="M16 4.5a3.5 3.5 0 0 1 0 7M18 14a6 6 0 0 1 3.5 6"/>' | split: ',' -%}
{%- for x in t -%}{%- assign p = x | split: '|' -%}<a class="d2-hub__a{% if page.handle == p[0] %} is-on{% endif %}" href="/pages/{{ p[0] }}"{% if page.handle == p[0] %} aria-current="page"{% endif %}><svg class="d2-ico" viewBox="0 0 24 24" aria-hidden="true" focusable="false">{{ p[2] }}</svg><span>{{ p[1] }}</span></a>{%- endfor -%}
</nav></div></div>
